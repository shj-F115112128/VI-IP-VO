<mxfile host="app.diagrams.net">
  <diagram name="breakdown" id="breakdown1">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="TOP" value="&lt;b&gt;mean3x3_linebuffer&lt;/b&gt;&lt;br&gt;(top module)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1b2733;strokeColor=#0d141a;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1224.0" y="80" width="320" height="100" as="geometry"/></mxCell><mxCell id="G1" value="&lt;b&gt;子模組&lt;/b&gt;&lt;br&gt;Line Buffer 讀寫&lt;br&gt;(line1 / line2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3b6ea5;strokeColor=#1d3c5c;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="200.0" y="340" width="240" height="110" as="geometry"/></mxCell><mxCell id="P1" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;先讀舊值(previous_line_pixel /&lt;br&gt;two_lines_back_pixel)再寫入新畫素" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="P2" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;line1→line2 逐列搬移&lt;br&gt;(模擬兩條 BRAM 各延遲一列)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="340" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="G2" value="&lt;b&gt;子模組&lt;/b&gt;&lt;br&gt;3x3 視窗移位&lt;br&gt;(top0~bot2 shift window)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3b6ea5;strokeColor=#1d3c5c;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="760.0" y="340" width="240" height="110" as="geometry"/></mxCell><mxCell id="P3" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;x_cnt=0(換行)時視窗重置,&lt;br&gt;不繼承上一列尾端像素" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="P4" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;其餘情況 top/mid/bot&lt;br&gt;各自右移補新值" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="G3" value="&lt;b&gt;子模組&lt;/b&gt;&lt;br&gt;Mean 濾波分支" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3b6ea5;strokeColor=#1d3c5c;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180.0" y="340" width="240" height="110" as="geometry"/></mxCell><mxCell id="P5" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;window_valid=(x_cnt&gt;=2 且 y_cnt&gt;=2)&lt;br&gt;時 9-pixel 相加 / 9 → pixel_out" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1180" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="G4" value="&lt;b&gt;子模組&lt;/b&gt;&lt;br&gt;Sobel 邊緣偵測分支" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3b6ea5;strokeColor=#1d3c5c;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1740.0" y="340" width="240" height="110" as="geometry"/></mxCell><mxCell id="P6" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;Gx = 右欄-左欄(1,2,1 加權)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1460" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="P7" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;Gy = 上列-下列(1,2,1 加權)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="1740" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="P8" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;|Gx|+|Gy| 飽和至 255 → sobel_mag&lt;br&gt;&gt; EDGE_THRESHOLD → sobel_edge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="2020" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="G5" value="&lt;b&gt;子模組&lt;/b&gt;&lt;br&gt;座標/時序控制&lt;br&gt;(x_cnt / y_cnt / out_valid)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3b6ea5;strokeColor=#1d3c5c;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="2440.0" y="340" width="240" height="110" as="geometry"/></mxCell><mxCell id="P9" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;x_cnt/y_cnt 計數,&lt;br&gt;換行/換幀進位" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="2300" y="610" width="240" height="130" as="geometry"/></mxCell><mxCell id="P10" value="&lt;b&gt;邏輯區塊&lt;/b&gt;&lt;br&gt;rst=&apos;1&apos; 同步重置&lt;br&gt;所有暫存器/計數器" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a5a5e;strokeColor=#26302f;fontColor=#ffffff;fontSize=15;align=center;verticalAlign=middle;arcSize=8;spacing=6;" vertex="1" parent="1"><mxGeometry x="2580" y="610" width="240" height="130" as="geometry"/></mxCell>
